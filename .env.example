# Neon Postgres connection string (pooled connection recommended for Next.js runtime,
# a direct/unpooled connection also works for the worker's persistent pg Pool).
# Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign/verify student JWTs (httpOnly session cookie). Generate with
# `openssl rand -base64 32` or similar — keep this secret and rotate if leaked.
JWT_SECRET="replace-with-a-long-random-secret"

# Secret used to derive the AES-256-GCM key for encrypting the stored portal PIN
# (students.encrypted_pin / scrape_jobs.encrypted_pin) at rest. Keep separate from
# JWT_SECRET. Generate with `openssl rand -base64 32` or similar.
ENCRYPTION_SECRET="replace-with-a-different-long-random-secret"

# Optional: only needed to exercise the live scraper against the real portal
# (https://parents.msrit.edu/newparents/) during development/testing.
# MSR_PORTAL_TEST_USN=
# MSR_PORTAL_TEST_DOB=
# MSR_PORTAL_TEST_AUTH_TYPE=
# MSR_PORTAL_TEST_LAST4=
