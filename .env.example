# Neon Postgres connection string (pooled connection recommended for Next.js route handlers).
# Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign/verify student JWTs (httpOnly session cookie). Generate with
# `openssl rand -base64 32` or similar — keep this secret and rotate if leaked.
JWT_SECRET="replace-with-a-long-random-secret"

# Secret used to derive the AES-256-GCM key for encrypting the stored portal PIN
# (students.encrypted_pin / scrape_jobs.encrypted_pin) at rest.
# Keep separate from JWT_SECRET. Generate with `openssl rand -base64 32` or similar.
ENCRYPTION_SECRET="replace-with-a-different-long-random-secret"

# Protects /api/cron/refresh-student-years, the yearly job (vercel.json) that moves every student to the right
# year each 1 August. Vercel sends it as Authorization: Bearer <value> when it runs the job. Without it the
# route refuses to run. Generate with openssl rand -base64 32 or similar.
CRON_SECRET="replace-with-another-long-random-secret"